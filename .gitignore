# ==========================================
# DevTracker Backend — .gitignore
# Node.js + Express + TypeScript
# ==========================================

# ── Dependencies ──────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build Output ──────────────────────────
dist/
build/

# ── Environment Variables ─────────────────
# NEVER commit secrets, DB URIs, or API keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── TypeScript ────────────────────────────
*.tsbuildinfo

# ── Logs ─────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── File Uploads (local temp storage) ─────
uploads/
tmp/

# ── Testing ───────────────────────────────
coverage/
.nyc_output/

# ── Editor & IDE ──────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── OS Generated ──────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Render ────────────────────────────────
.render/

# ── Misc ──────────────────────────────────
*.local
.cache/
